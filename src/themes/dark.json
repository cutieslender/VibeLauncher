{
  "id": "dark",
  "name": "Dark",
  "description": "Thème sombre épuré — professionnel et reposant pour les yeux",
  "author": "VibeLauncher",
  "version": "1.0.0",
  
  "colors": {
    "bg": "#0a0a0a",
    "surface": "rgba(18, 18, 18, 0.95)",
    "surface2": "rgba(28, 28, 28, 0.90)",
    "surface3": "rgba(38, 38, 38, 0.90)",
    "border": "rgba(255, 255, 255, 0.08)",
    "accent": "#e0e0e0",
    "accent2": "#a0a0a0",
    "accent3": "#ffffff",
    "green": "#4caf50",
    "gold": "#ffc107",
    "red": "#f44336",
    "orange": "#ff9800",
    "text": "#e8e8e8",
    "text2": "#999999",
    "text3": "#555555",
    "forge": "#e07020",
    "fabric": "#c4a020",
    "glow": "0 0 15px rgba(255, 255, 255, 0.08)",
    "glow_strong": "0 0 30px rgba(255, 255, 255, 0.15)"
  },

  "rgb": { "r": 200, "g": 200, "b": 200 },

  "typography": {
    "heading": "'Orbitron', sans-serif",
    "body": "'Rajdhani', sans-serif",
    "mono": "'Share Tech Mono', monospace"
  },

  "background": {
    "type": "solid",
    "gradient": "linear-gradient(180deg, #0a0a0a 0%, #111111 100%)",
    "particles": { "enabled": false },
    "overlay": "none"
  },

  "effects": {
    "glassmorphism": false,
    "blur": "0px",
    "borderGlow": false,
    "hoverScale": 1.01,
    "transitionSpeed": "0.2s",
    "scrollbarColor": "rgba(255, 255, 255, 0.15)",
    "selectionBg": "rgba(255, 255, 255, 0.15)",
    "selectionColor": "#fff"
  },

  "sidebar": {
    "background": "rgba(12, 12, 12, 0.85)",
    "activeGlow": "none",
    "hoverBorder": "rgba(255, 255, 255, 0.15)",
    "logoShadow": "0 0 20px rgba(255, 255, 255, 0.3)"
  },

  "buttons": {
    "primary": {
      "background": "rgba(255, 255, 255, 0.06)",
      "border": "rgba(255, 255, 255, 0.15)",
      "hoverBackground": "rgba(255, 255, 255, 0.12)",
      "hoverShadow": "none"
    },
    "launch": {
      "background": "rgba(255, 255, 255, 0.05)",
      "border": "rgba(255, 255, 255, 0.3)",
      "hoverBackground": "rgba(255, 255, 255, 0.15)",
      "hoverColor": "#ffffff",
      "glowAnimation": false
    }
  },

  "animations": {},

  "customCSS": [
    "body::before { background: #0a0a0a; opacity: 1 !important; }",
    ".page-header h2 { color: #e0e0e0 !important; text-shadow: none !important; }",
    ".nav-btn.active { background: rgba(255,255,255,0.06) !important; border-color: rgba(255,255,255,0.15) !important; }",
    "::-webkit-scrollbar-thumb { background: rgba(255,255,255,0.12) !important; }",
    "::selection { background: rgba(255,255,255,0.15); }"
  ]
}
