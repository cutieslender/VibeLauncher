{
  "id": "neon",
  "name": "Neon",
  "description": "Lumières néon intenses sur fond sombre — ambiance arcade nocturne",
  "author": "VibeLauncher",
  "version": "1.0.0",
  
  "colors": {
    "bg": "#050510",
    "surface": "rgba(8, 8, 30, 0.95)",
    "surface2": "rgba(12, 12, 45, 0.90)",
    "surface3": "rgba(18, 18, 60, 0.90)",
    "border": "rgba(0, 255, 255, 0.15)",
    "accent": "#00ffff",
    "accent2": "#00cccc",
    "accent3": "#80ffff",
    "green": "#39ff14",
    "gold": "#ffff00",
    "red": "#ff0055",
    "orange": "#ff6600",
    "text": "#e0f0ff",
    "text2": "#80b0d0",
    "text3": "#405060",
    "forge": "#ff6600",
    "fabric": "#ffcc00",
    "glow": "0 0 25px rgba(0, 255, 255, 0.4)",
    "glow_strong": "0 0 50px rgba(0, 255, 255, 0.6)"
  },

  "rgb": { "r": 0, "g": 255, "b": 255 },

  "background": {
    "type": "gradient-animated",
    "gradient": "linear-gradient(135deg, #050510 0%, #0a0a30 30%, #0d0535 60%, #050510 100%)",
    "particles": {
      "enabled": true,
      "type": "dots",
      "color": "rgba(0, 255, 255, 0.12)",
      "count": 30,
      "speed": 0.5
    },
    "overlay": "radial-gradient(ellipse at 20% 80%, rgba(0,255,255,0.04) 0%, transparent 50%), radial-gradient(ellipse at 80% 20%, rgba(255,0,85,0.03) 0%, transparent 50%)"
  },

  "effects": {
    "glassmorphism": true,
    "blur": "15px",
    "borderGlow": true,
    "hoverScale": 1.03,
    "transitionSpeed": "0.25s",
    "scrollbarColor": "rgba(0, 255, 255, 0.4)",
    "selectionBg": "rgba(0, 255, 255, 0.3)",
    "selectionColor": "#050510"
  },

  "sidebar": {
    "background": "rgba(5, 5, 20, 0.8)",
    "activeGlow": "inset 0 0 30px rgba(0, 255, 255, 0.1)",
    "hoverBorder": "rgba(0, 255, 255, 0.4)",
    "logoShadow": "0 0 40px rgba(0, 255, 255, 0.9), 0 0 80px rgba(0, 255, 255, 0.4)"
  },

  "animations": {
    "backgroundKeyframes": {
      "name": "neon-flicker",
      "css": "@keyframes neon-flicker { 0%, 19%, 21%, 23%, 25%, 54%, 56%, 100% { text-shadow: 0 0 20px rgba(0,255,255,0.8), 0 0 40px rgba(0,255,255,0.4); } 20%, 24%, 55% { text-shadow: none; } }",
      "duration": "3s",
      "timing": "ease-in-out"
    },
    "borderPulse": {
      "name": "neon-border-pulse",
      "css": "@keyframes neon-border-pulse { 0%, 100% { border-color: rgba(0,255,255,0.3); } 50% { border-color: rgba(0,255,255,0.6); } }",
      "duration": "2s"
    }
  },

  "customCSS": [
    "body::before { background: linear-gradient(135deg, #050510, #0a0a30, #0d0535, #050510); background-size: 400% 400%; animation: astolfo-bg-shimmer 20s ease-in-out infinite; opacity: 1 !important; }",
    ".logo-main h1 { animation: neon-flicker 3s ease-in-out infinite; }",
    ".launch-btn { border: 1px solid rgba(0,255,255,0.5) !important; text-shadow: 0 0 15px rgba(0,255,255,0.5); }",
    ".launch-btn:hover { box-shadow: 0 0 30px rgba(0,255,255,0.5), inset 0 0 20px rgba(0,255,255,0.1) !important; }",
    ".version-card.selected { border-color: #00ffff !important; box-shadow: 0 0 30px rgba(0,255,255,0.4) !important; }",
    "::selection { background: rgba(0,255,255,0.3); color: #050510; }",
    "::-webkit-scrollbar-thumb { background: rgba(0,255,255,0.3) !important; }",
    ".page-header h2 { color: #00ffff !important; text-shadow: 0 0 30px rgba(0,255,255,0.6) !important; }",
    ".nav-btn.active { background: rgba(0,255,255,0.1) !important; border-color: rgba(0,255,255,0.5) !important; color: #00ffff !important; box-shadow: inset 0 0 30px rgba(0,255,255,0.08), 0 0 15px rgba(0,255,255,0.2) !important; }",
    ".card { border: 1px solid rgba(0,255,255,0.08); }"
  ]
}
